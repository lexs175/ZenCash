---
// Comparison.astro - Tabla comparativa adaptativa (Tabla en desktop, tarjetas en móvil sin desbordes)
const rows = [
  {
    feature: 'Aprobación del pago',
    zencash: 'Garantizada al instante vía Yape o transferencia bancaria',
    traditional: 'Rechazos continuos por bloqueos de tarjetas en Bolivia',
  },
  {
    feature: 'Tiempo de acreditación',
    zencash: 'Menos de 3 minutos directo a tu cuenta',
    traditional: 'Horas o días de espera a que procese',
  },
  {
    feature: 'Moneda y comisiones',
    zencash: 'En Bolivianos exactos o USDT, 0% comisiones ocultas',
    traditional: 'Cargos extra por cambio forzado a dólares',
  },
  {
    feature: 'Soporte y atención',
    zencash: 'Cajero humano en vivo por WhatsApp 24/7',
    traditional: 'Bots automáticos o respuestas en inglés',
  },
  {
    feature: 'Bono de bienvenida',
    zencash: '+50% extra directo en tu primera recarga',
    traditional: 'Sin bonos locales o con requisitos confusos',
  },
  {
    feature: 'Retiro de ganancias',
    zencash: 'Transferencia directa a tu banco o Yape en minutos',
    traditional: 'Días de espera o trabas para transferir a Bolivia',
  }
];
---
<section class="comp-section block-white" id="comparativa">
  <div class="container">
    <div class="section-title-wrap">
      <h2>¿Por qué ZenCash?</h2>
      <p class="section-subtext">
        Facilidad de recargas y retiros sin esperas ni tarjetas bloqueadas. Solo contáctanos y operamos al instante.
      </p>
    </div>

    <!-- Vista Desktop: Tabla rígida y alineada -->
    <div class="desktop-table-wrap">
      <table class="clean-table">
        <thead>
          <tr>
            <th class="col-head-feature">Detalle</th>
            <th class="col-head-zencash">
              <div class="col-brand-header">
                <span class="logo-comparison" role="img" aria-label="ZenCash"></span>
              </div>
            </th>
            <th class="col-head-trad">
              <span class="trad-title">Tarjeta Bancaria Tradicional</span>
              <span class="trad-sub">Directo en la web</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="cell-feat">
                <strong>{r.feature}</strong>
              </td>
              <td class="cell-zen">
                <div class="cell-content">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00C853" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="svg-check" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>{r.zencash}</span>
                </div>
              </td>
              <td class="cell-trad">
                <div class="cell-content">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E11D48" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="svg-cross" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                  <span>{r.traditional}</span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Vista Móvil: Tarjetas individuales (cero scroll horizontal, cero cortes) -->
    <div class="mobile-comp-cards">
      {rows.map((r) => (
        <div class="m-card">
          <div class="m-card-header">
            <h4>{r.feature}</h4>
          </div>
          <div class="m-card-body">
            <!-- Opción Zencash -->
            <div class="m-zen-row">
              <div class="m-brand-badge">
                <span class="m-dot"></span>
                <span>Con Zencash (Cajero)</span>
              </div>
              <div class="m-val-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00C853" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="svg-check" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <strong>{r.zencash}</strong>
              </div>
            </div>

            <!-- Opción Tarjeta Tradicional -->
            <div class="m-trad-row">
              <div class="m-trad-badge">
                <span>Tarjeta en la web</span>
              </div>
              <div class="m-val-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E11D48" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="svg-cross" aria-hidden="true">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
                <span>{r.traditional}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .comp-section {
    padding: var(--space-16) 0 var(--space-20);
  }

  .section-title-wrap {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--space-10);
  }

  .section-title-wrap h2 {
    color: var(--color-text-dark);
    margin-bottom: var(--space-2);
  }

  .section-subtext {
    font-size: var(--font-size-md);
    color: var(--color-text-body);
  }

  /* Tabla Desktop */
  .desktop-table-wrap {
    display: block;
    background-color: var(--color-bg-white);
    border: 1.5px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    overflow-x: auto;
    max-width: 100%;
    -webkit-overflow-scrolling: touch;
    box-shadow: var(--shadow-card);
  }

  .clean-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    text-align: left;
  }

  .clean-table th {
    padding: var(--space-5) var(--space-6);
    border-bottom: 2px solid var(--color-border-subtle);
    vertical-align: middle;
  }

  .col-head-feature,
  .cell-feat {
    width: 28%;
  }

  .col-head-feature {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-black);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .col-head-zencash,
  .cell-zen {
    width: 38%;
    background-color: var(--color-primary-light);
    border-left: 2px solid #C7D9FE;
    border-right: 2px solid #C7D9FE;
  }

  .col-brand-header {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .logo-comparison {
    display: inline-block;
    width: 120px;
    height: 30px;
    background-color: var(--color-primary);
    -webkit-mask: url("/logo.svg") no-repeat left center / contain;
    mask: url("/logo.svg") no-repeat left center / contain;
  }

  .col-tag {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-primary);
  }

  .col-head-trad,
  .cell-trad {
    width: 34%;
  }

  .trad-title {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-dark);
  }

  .trad-sub {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .clean-table td {
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-border-subtle);
    font-size: var(--font-size-sm);
    vertical-align: middle;
  }

  .cell-feat {
    color: var(--color-text-dark);
  }

  .cell-content {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .cell-zen .cell-content span {
    font-weight: var(--font-weight-bold);
    color: var(--color-text-dark);
    line-height: var(--leading-normal);
  }

  .cell-trad .cell-content span {
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  .svg-check {
    flex-shrink: 0;
    margin-top: 2px;
    background-color: #DCFCE7;
    padding: 3px;
    border-radius: var(--radius-full);
  }

  .svg-cross {
    flex-shrink: 0;
    margin-top: 2px;
    background-color: #FFE4E6;
    padding: 3px;
    border-radius: var(--radius-full);
  }

  /* Vista Móvil (Tarjetas) - Estrictamente oculto en Desktop */
  .mobile-comp-cards {
    display: none !important;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
  }

  .m-card {
    background-color: var(--color-bg-white);
    border: 1.5px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .m-card-header {
    background-color: #F8FAFC;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .m-card-header h4 {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-black);
    color: var(--color-text-dark);
    margin: 0;
  }

  .m-card-body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .m-zen-row {
    background-color: var(--color-primary-light);
    border: 1px solid #BFDBFE;
    border-radius: var(--radius-md);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .m-brand-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 11px;
    font-weight: var(--font-weight-black);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .m-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
  }

  .m-trad-row {
    background-color: #FAFAFA;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .m-trad-badge {
    font-size: 11px;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-muted);
  }

  .m-val-box {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    line-height: 1.4;
  }

  .m-zen-row .m-val-box strong {
    color: var(--color-text-dark);
  }

  .m-trad-row .m-val-box span {
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .comp-section {
      padding: var(--space-10) 0 var(--space-12);
    }

    .desktop-table-wrap {
      display: none !important;
    }

    .mobile-comp-cards {
      display: flex !important;
    }
  }
</style>
