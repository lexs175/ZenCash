---
// Calculator.astro - Calculadora de recargas estilo nocnoc: fondo azul cobalto con tarjeta blanca nítida
import { SITE_CONFIG } from '../config';
---
<section class="calc-section block-blue" id="calculadora">
  <div class="container">
    <div class="calc-title-wrap">
      <h2>Calcula cuánto vas a recibir</h2>
      <p class="calc-subtext">
        Elige tu monto y mira cuánto saldo juegas con tu bono de bienvenida del +50%.
      </p>
    </div>

    <div class="calc-card">
      <!-- Selector de Moneda (Sin emojis) -->
      <div class="currency-switch">
        <button type="button" class="curr-btn active" id="btn-bob" data-currency="Bs.">
          Bolivianos (Bs.)
        </button>
        <button type="button" class="curr-btn" id="btn-usdt" data-currency="USDT">
          USDT (Binance Pay)
        </button>
      </div>

      <!-- Presets de Monto -->
      <div class="presets-row">
        <button type="button" class="preset-btn" data-amount="50">50</button>
        <button type="button" class="preset-btn active" data-amount="100">100</button>
        <button type="button" class="preset-btn" data-amount="200">200</button>
        <button type="button" class="preset-btn" data-amount="500">500</button>
        <button type="button" class="preset-btn" data-amount="1000">1,000</button>
        <button type="button" class="preset-btn" data-amount="2000">2,000</button>
      </div>

      <!-- Input de Monto -->
      <div class="input-block">
        <label for="custom-amount" class="input-desc">O escribe el monto exacto:</label>
        <div class="input-box">
          <span class="curr-label" id="curr-label">Bs.</span>
          <input 
            type="number" 
            id="custom-amount" 
            value="100" 
            min="20" 
            max="100000" 
            step="10"
            aria-label="Monto a recargar"
          />
        </div>
        <span class="input-hint">Mínimo: 20 Bs. / 5 USDT</span>
      </div>

      <!-- Resumen de Saldos -->
      <div class="summary-box">
        <div class="summary-item">
          <span>Tú transfieres:</span>
          <strong id="disp-deposit">100.00 Bs.</strong>
        </div>
        <div class="summary-item bonus-highlight">
          <span>Bono de bienvenida (+50%):</span>
          <strong id="disp-bonus">+50.00 Bs.</strong>
        </div>
        <div class="summary-line"></div>
        <div class="summary-item total-highlight">
          <span>Total en tu cuenta:</span>
          <strong id="disp-total">150.00 Bs.</strong>
        </div>
      </div>

      <!-- Botones de Acción Proporcionados -->
      <div class="calc-cta-wrap">
        <a 
          href="https://wa.me/59176996388?text=Hola%20Zencash,%20quiero%20hacer%20mi%20primera%20recarga%20de%20100%20Bs.%20en%201xBet%20con%20la%20promo%20de%20bienvenida%20del%2050%25.%20Mi%20ID%20es:%20" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="zen-btn-calc zen-btn-wa" 
          id="btn-whatsapp-calc"
        >
          <svg class="btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.014 8.00613C6.12827 7.1024 7.30277 5.87414 8.23488 6.01043L8.23339 6.00894C9.14051 6.18132 9.85859 7.74261 10.2635 8.44465C10.5504 8.95402 10.3641 9.4701 10.0965 9.68787C9.7355 9.97883 9.17099 10.3803 9.28943 10.7834C9.5 11.5 12 14 13.2296 14.7107C13.695 14.9797 14.0325 14.2702 14.3207 13.9067C14.5301 13.6271 15.0466 13.46 15.5548 13.736C16.3138 14.178 17.0288 14.6917 17.69 15.27C18.0202 15.546 18.0977 15.9539 17.8689 16.385C17.4659 17.1443 16.3003 18.1456 15.4542 17.9421C13.9764 17.5868 8 15.27 6.08033 8.55801C5.97237 8.24048 5.99955 8.12044 6.014 8.00613Z"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 23C10.7764 23 10.0994 22.8687 9 22.5L6.89443 23.5528C5.56462 24.2177 4 23.2507 4 21.7639V19.5C1.84655 17.492 1 15.1767 1 12C1 5.92487 5.92487 1 12 1C18.0751 1 23 5.92487 23 12C23 18.0751 18.0751 23 12 23ZM6 18.6303L5.36395 18.0372C3.69087 16.4772 3 14.7331 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12C21 16.9706 16.9706 21 12 21C11.0143 21 10.552 20.911 9.63595 20.6038L8.84847 20.3397L6 21.7639V18.6303Z"/>
          </svg>
          <span id="btn-text">RECARGAR 100 BS. POR WHATSAPP</span>
        </a>

        <a 
          href={SITE_CONFIG.telegramDirect} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="zen-btn-calc zen-btn-tg"
          id="btn-telegram-calc"
        >
          <svg class="btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12,2C6.5,2,2,6.5,2,12s4.5,10,10,10s10-4.5,10-10S17.5,2,12,2z M16.9,8.1l-1.7,8.2c-0.1,0.6-0.5,0.7-0.9,0.4l-2.6-2 c-0.6,0.6-1.2,1.1-1.3,1.3c-0.2,0.1-0.3,0.3-0.5,0.3c-0.3,0-0.3-0.2-0.4-0.4l-0.9-3L5.9,12c-0.6-0.2-0.6-0.6,0.1-0.9l10.2-3.9 C16.6,7.1,17.1,7.3,16.9,8.1z M14.5,9l-5.7,3.6l0.9,3l0.2-2l4.9-4.4C15.1,8.9,14.9,8.9,14.5,9z"/>
          </svg>
          <span id="btn-tg-text">RECARGAR 100 BS. POR TELEGRAM</span>
        </a>

        <div class="calc-perks">
          <div class="perk-point">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00C853" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Acreditación en 3 min</span>
          </div>
          <span class="perk-dot">•</span>
          <div class="perk-point">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00C853" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Bono 50% garantizado</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .calc-section {
    padding: var(--space-20) 0;
  }

  .calc-title-wrap {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--space-10);
  }

  .calc-title-wrap h2 {
    color: var(--color-text-white);
    margin-bottom: var(--space-3);
  }

  .calc-subtext {
    font-size: var(--font-size-lg);
    color: var(--color-text-blue-light);
  }

  .calc-card {
    max-width: 620px;
    margin: 0 auto;
    background-color: var(--color-bg-white);
    color: var(--color-text-dark);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-elevated);
    border: 3px solid #FFFFFF;
  }

  .currency-switch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    background-color: var(--color-primary-light);
    padding: var(--space-1);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
  }

  .curr-btn {
    padding: var(--space-3) var(--space-4);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-body);
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .curr-btn.active {
    background-color: var(--color-primary);
    color: var(--color-text-white);
    box-shadow: var(--shadow-card);
  }

  .presets-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .preset-btn {
    padding: var(--space-2) var(--space-4);
    background-color: #F1F5F9;
    border: 1.5px solid var(--color-border-subtle);
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-dark);
    transition: all var(--transition-fast);
  }

  .preset-btn:hover {
    border-color: var(--color-primary);
  }

  .preset-btn.active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-white);
  }

  .input-block {
    margin-bottom: var(--space-6);
  }

  .input-desc {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  .input-box {
    display: flex;
    align-items: center;
    background-color: #F8FAFC;
    border: 2px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-2) var(--space-4);
    transition: border-color var(--transition-fast);
  }

  .input-box:focus-within {
    border-color: var(--color-primary);
    background-color: var(--color-bg-white);
  }

  .curr-label {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-black);
    color: var(--color-primary);
    margin-right: var(--space-2);
  }

  .input-box input {
    width: 100%;
    border: none;
    background: transparent;
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-black);
    color: var(--color-text-dark);
    font-family: inherit;
    outline: none;
  }

  .input-hint {
    display: block;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  /* Resumen */
  .summary-box {
    background-color: var(--color-primary-light);
    border: 1.5px solid #C7D9FE;
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .summary-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--font-size-sm);
    color: var(--color-text-body);
  }

  .summary-item strong {
    font-size: var(--font-size-md);
    color: var(--color-text-dark);
  }

  .bonus-highlight {
    color: #15803D;
  }

  .bonus-highlight strong {
    color: #15803D;
  }

  .summary-line {
    height: 1px;
    background-color: #C7D9FE;
    margin: var(--space-1) 0;
  }

  .total-highlight {
    padding-top: var(--space-1);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-dark);
  }

  .total-highlight strong {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-black);
    color: var(--color-primary);
  }

  .calc-cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
  }

  .zen-btn-calc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: auto;
    max-width: 100%;
    box-sizing: border-box;
    font-weight: var(--font-weight-extrabold);
    text-decoration: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    border: none;
    line-height: 1;
    text-align: center;
    transition: transform var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .zen-btn-calc:hover {
    transform: translateY(-2px);
  }

  .zen-btn-wa {
    background-color: #00C853 !important;
    color: #FFFFFF !important;
    padding: 12px 22px;
    font-size: 15px;
    box-shadow: 0 4px 14px rgba(0, 200, 83, 0.45);
  }

  .zen-btn-wa:hover {
    background-color: #00B348 !important;
    box-shadow: 0 6px 20px rgba(0, 200, 83, 0.6);
  }

  .zen-btn-tg {
    background-color: #229ED9 !important;
    color: #FFFFFF !important;
    padding: 10px 18px;
    font-size: 14px;
    box-shadow: 0 4px 14px rgba(34, 158, 217, 0.35);
  }

  .zen-btn-tg:hover {
    background-color: #1B8ABF !important;
    box-shadow: 0 6px 20px rgba(34, 158, 217, 0.5);
  }

  .btn-icon {
    width: 18px !important;
    height: 18px !important;
    min-width: 18px !important;
    max-width: 18px !important;
    flex-shrink: 0;
  }

  .calc-perks {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-weight: var(--font-weight-semibold);
  }

  .perk-point {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .perk-dot {
    opacity: 0.3;
  }

  @media (max-width: 480px) {
    .calc-card {
      padding: var(--space-4);
    }

    .zen-btn-wa {
      font-size: 13.5px;
      padding: 11px 16px;
    }

    .zen-btn-tg {
      font-size: 13px;
      padding: 9px 14px;
    }
  }
</style>

<script>
  let calcCurrency = 'Bs.';

  const bobBtn = document.getElementById('btn-bob');
  const usdtBtn = document.getElementById('btn-usdt');
  const currLabel = document.getElementById('curr-label');
  const amountInput = document.getElementById('custom-amount') as HTMLInputElement | null;
  const dispDep = document.getElementById('disp-deposit');
  const dispBon = document.getElementById('disp-bonus');
  const dispTot = document.getElementById('disp-total');
  const calcWaBtn = document.getElementById('btn-whatsapp-calc') as HTMLAnchorElement | null;
  const calcBtnText = document.getElementById('btn-text');
  const calcTgBtn = document.getElementById('btn-telegram-calc') as HTMLAnchorElement | null;
  const calcTgBtnText = document.getElementById('btn-tg-text');
  const chips = document.querySelectorAll('.preset-btn');

  function renderCalc() {
    if (!amountInput) return;
    const amount = parseFloat(amountInput.value) || 0;
    const bonus = amount * 0.5; // 50% bono de bienvenida en primera recarga
    const total = amount + bonus;

    if (dispDep) dispDep.textContent = `${amount.toLocaleString()} ${calcCurrency}`;
    if (dispBon) dispBon.textContent = `+${bonus.toLocaleString()} ${calcCurrency}`;
    if (dispTot) dispTot.textContent = `${total.toLocaleString()} ${calcCurrency}`;

    const waMsg = encodeURIComponent(
      `Hola Zencash, quiero hacer mi primera recarga de ${amount} ${calcCurrency} en 1xBet y aprovechar la promo de bienvenida del 50%. Mi ID es: `
    );
    if (calcWaBtn) {
      calcWaBtn.href = `https://wa.me/59176996388?text=${waMsg}`;
    }
    if (calcBtnText) {
      calcBtnText.textContent = `RECARGAR ${amount.toLocaleString()} ${calcCurrency.toUpperCase()} POR WHATSAPP`;
    }
    if (calcTgBtnText) {
      calcTgBtnText.textContent = `O RECARGAR ${amount.toLocaleString()} ${calcCurrency.toUpperCase()} POR TELEGRAM`;
    }
  }

  bobBtn?.addEventListener('click', () => {
    calcCurrency = 'Bs.';
    bobBtn.classList.add('active');
    usdtBtn?.classList.remove('active');
    if (currLabel) currLabel.textContent = 'Bs.';
    renderCalc();
  });

  usdtBtn?.addEventListener('click', () => {
    calcCurrency = 'USDT';
    usdtBtn.classList.add('active');
    bobBtn?.classList.remove('active');
    if (currLabel) currLabel.textContent = 'USDT';
    renderCalc();
  });

  chips.forEach((c) => {
    c.addEventListener('click', () => {
      chips.forEach(btn => btn.classList.remove('active'));
      c.classList.add('active');
      const val = c.getAttribute('data-amount');
      if (val && amountInput) {
        amountInput.value = val;
        renderCalc();
      }
    });
  });

  amountInput?.addEventListener('input', () => {
    chips.forEach(btn => btn.classList.remove('active'));
    renderCalc();
  });

  renderCalc();
</script>
