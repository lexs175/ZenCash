---
// TopBar.astro - Barra superior en azul vibrante con estado en tiempo real (Cero emojis)
import { SITE_CONFIG } from '../config';
---
<div class="topbar">
  <div class="container topbar-content">
    <div class="status-indicator">
      <span class="live-dot"></span>
      <span class="status-text">Cajero ZENCASH en línea • Atención 24/7 en Bolivia</span>
    </div>
    <div class="stats-ticker">
      <span class="ticker-item">Bono bienvenida: <strong>+10% en tu primera recarga</strong></span>
      <span class="ticker-sep">|</span>
      <span class="ticker-item">Acreditación: <strong>menos de 3 min</strong></span>
      <span class="ticker-sep">|</span>
      <a href={SITE_CONFIG.telegramGroup} target="_blank" rel="noopener noreferrer" class="topbar-group-btn">
        <svg class="topbar-tg-icon" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8-1.7 8.04c-.13.58-.47.72-.96.45l-2.6-1.92-1.25 1.2c-.14.14-.26.26-.53.26l.18-2.64 4.81-4.35c.21-.19-.05-.29-.32-.11l-5.95 3.75-2.56-.8c-.56-.17-.57-.56.12-.83l10-3.86c.46-.17.87.11.76.8z"/>
        </svg>
        <span>Únete al Grupo de Telegram</span>
        <span class="topbar-btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>

<style>
  .topbar {
    background-color: var(--color-bg-blue-dark);
    color: var(--color-text-white);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border-blue);
  }

  .topbar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent-yellow);
    box-shadow: 0 0 0 2px rgba(255, 184, 0, 0.3);
  }

  .stats-ticker {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-blue-light);
  }

  .stats-ticker strong {
    color: var(--color-text-white);
    font-weight: var(--font-weight-bold);
  }

  .ticker-sep {
    opacity: 0.3;
  }

  .topbar-group-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: rgba(34, 158, 217, 0.22);
    border: 1px solid rgba(34, 158, 217, 0.55);
    color: #FFFFFF;
    font-size: 11.5px;
    font-weight: var(--font-weight-bold);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .topbar-group-btn:hover {
    background-color: #229ED9;
    border-color: #229ED9;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(34, 158, 217, 0.4);
  }

  .topbar-tg-icon {
    flex-shrink: 0;
    color: #229ED9;
    transition: color var(--transition-fast);
  }

  .topbar-group-btn:hover .topbar-tg-icon {
    color: #FFFFFF;
  }

  .topbar-btn-arrow {
    color: var(--color-accent-yellow);
    font-weight: var(--font-weight-black);
    transition: transform var(--transition-fast);
  }

  .topbar-group-btn:hover .topbar-btn-arrow {
    transform: translateX(2px);
  }

  @media (max-width: 640px) {
    .stats-ticker {
      display: none;
    }
    .topbar-content {
      justify-content: center;
    }
  }
</style>
