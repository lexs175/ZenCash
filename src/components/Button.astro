---
// Button.astro - Sistema oficial de botones con jerarquía visual y adaptación a fondos
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'telegram' | 'secondary' | 'outline' | 'ghost';
  on?: 'blue' | 'light';
  size?: 'sm' | 'md' | 'lg';
  icon?: 'whatsapp' | 'telegram' | 'arrow' | 'none';
  fullWidth?: boolean;
  class?: string;
  id?: string;
  target?: string;
  rel?: string;
  [key: string]: any;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  on = 'blue',
  size = 'md',
  icon = variant === 'primary' ? 'whatsapp' : variant === 'telegram' ? 'telegram' : 'none',
  fullWidth = false,
  class: className = '',
  id,
  target,
  rel,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const isExternal = href && href.startsWith('http');
const finalTarget = target || (isExternal ? '_blank' : undefined);
const finalRel = rel || (isExternal ? 'noopener noreferrer' : undefined);
---

<Tag
  href={href}
  type={!href ? type : undefined}
  class:list={[
    'zen-btn',
    `zen-btn--${variant}`,
    `zen-btn--on-${on}`,
    `zen-btn--${size}`,
    { 'zen-btn--full': fullWidth },
    className
  ]}
  id={id}
  target={finalTarget}
  rel={finalRel}
  {...rest}
>
  {icon === 'whatsapp' && (
    <svg class="zen-btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M6.014 8.00613C6.12827 7.1024 7.30277 5.87414 8.23488 6.01043L8.23339 6.00894C9.14051 6.18132 9.85859 7.74261 10.2635 8.44465C10.5504 8.95402 10.3641 9.4701 10.0965 9.68787C9.7355 9.97883 9.17099 10.3803 9.28943 10.7834C9.5 11.5 12 14 13.2296 14.7107C13.695 14.9797 14.0325 14.2702 14.3207 13.9067C14.5301 13.6271 15.0466 13.46 15.5548 13.736C16.3138 14.178 17.0288 14.6917 17.69 15.27C18.0202 15.546 18.0977 15.9539 17.8689 16.385C17.4659 17.1443 16.3003 18.1456 15.4542 17.9421C13.9764 17.5868 8 15.27 6.08033 8.55801C5.97237 8.24048 5.99955 8.12044 6.014 8.00613Z"/>
      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 23C10.7764 23 10.0994 22.8687 9 22.5L6.89443 23.5528C5.56462 24.2177 4 23.2507 4 21.7639V19.5C1.84655 17.492 1 15.1767 1 12C1 5.92487 5.92487 1 12 1C18.0751 1 23 5.92487 23 12C23 18.0751 18.0751 23 12 23ZM6 18.6303L5.36395 18.0372C3.69087 16.4772 3 14.7331 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12C21 16.9706 16.9706 21 12 21C11.0143 21 10.552 20.911 9.63595 20.6038L8.84847 20.3397L6 21.7639V18.6303Z"/>
    </svg>
  )}
  {icon === 'telegram' && (
    <svg class="zen-btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12,2C6.5,2,2,6.5,2,12s4.5,10,10,10s10-4.5,10-10S17.5,2,12,2z M16.9,8.1l-1.7,8.2c-0.1,0.6-0.5,0.7-0.9,0.4l-2.6-2 c-0.6,0.6-1.2,1.1-1.3,1.3c-0.2,0.1-0.3,0.3-0.5,0.3c-0.3,0-0.3-0.2-0.4-0.4l-0.9-3L5.9,12c-0.6-0.2-0.6-0.6,0.1-0.9l10.2-3.9 C16.6,7.1,17.1,7.3,16.9,8.1z M14.5,9l-5.7,3.6l0.9,3l0.2-2l4.9-4.4C15.1,8.9,14.9,8.9,14.5,9z"/>
    </svg>
  )}
  {icon === 'arrow' && (
    <svg class="zen-btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  )}
  <span class="zen-btn-text"><slot /></span>
</Tag>

<style>
  .zen-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: inherit;
    font-weight: var(--font-weight-extrabold);
    text-decoration: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    border: none;
    line-height: 1;
    white-space: nowrap;
    text-align: center;
    max-width: 100%;
    box-sizing: border-box;
    transition: transform var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .zen-btn:hover {
    transform: translateY(-2px);
  }

  .zen-btn:active {
    transform: translateY(0);
  }

  /* --- TAMAÑOS PROPORCIONADOS --- */
  .zen-btn--sm {
    padding: 7px 14px;
    font-size: var(--font-size-xs);
  }

  .zen-btn--md {
    padding: 10px 18px;
    font-size: var(--font-size-sm);
  }

  .zen-btn--lg {
    padding: 12px 22px;
    font-size: 15px;
  }

  .zen-btn--full {
    width: 100%;
  }

  /* --- BOTÓN PRINCIPAL (CTA DE CONVERSIÓN WHATSAPP) --- */
  .zen-btn--primary {
    background-color: #00C853 !important;
    color: #FFFFFF !important;
    box-shadow: 0 4px 14px rgba(0, 200, 83, 0.45);
  }

  .zen-btn--primary:hover {
    background-color: #00B348 !important;
    box-shadow: 0 6px 20px rgba(0, 200, 83, 0.6);
  }

  /* --- BOTÓN TELEGRAM --- */
  .zen-btn--telegram {
    background-color: #229ED9 !important;
    color: #FFFFFF !important;
    box-shadow: 0 4px 14px rgba(34, 158, 217, 0.35);
  }

  .zen-btn--telegram:hover {
    background-color: #1B8ABF !important;
    box-shadow: 0 6px 20px rgba(34, 158, 217, 0.5);
  }

  /* --- BOTÓN SECUNDARIO SEGÚN FONDO --- */
  /* Secundario sobre fondo AZUL (destaca en blanco limpio) */
  .zen-btn--secondary.zen-btn--on-blue {
    background-color: var(--color-bg-white);
    color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .zen-btn--secondary.zen-btn--on-blue:hover {
    background-color: #F0F5FF;
    color: var(--color-primary-dark);
  }

  /* Secundario sobre fondo CLARO (destaca en azul cobalto o grafito) */
  .zen-btn--secondary.zen-btn--on-light {
    background-color: var(--color-primary);
    color: var(--color-text-white);
    box-shadow: 0 4px 14px rgba(0, 82, 255, 0.25);
  }

  .zen-btn--secondary.zen-btn--on-light:hover {
    background-color: var(--color-primary-dark);
  }

  /* --- BOTÓN OUTLINE SEGÚN FONDO --- */
  /* Outline sobre fondo AZUL */
  .zen-btn--outline.zen-btn--on-blue {
    background-color: rgba(255, 255, 255, 0.12);
    color: var(--color-text-white);
    border: 1.5px solid rgba(255, 255, 255, 0.4);
  }

  .zen-btn--outline.zen-btn--on-blue:hover {
    background-color: rgba(255, 255, 255, 0.22);
    border-color: #FFFFFF;
  }

  /* Outline sobre fondo CLARO */
  .zen-btn--outline.zen-btn--on-light {
    background-color: var(--color-bg-white);
    color: var(--color-text-dark);
    border: 1.5px solid var(--color-border-subtle);
    box-shadow: var(--shadow-card);
  }

  .zen-btn--outline.zen-btn--on-light:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* --- BOTÓN GHOST --- */
  .zen-btn--ghost.zen-btn--on-blue {
    background-color: transparent;
    color: var(--color-text-white);
  }

  .zen-btn--ghost.zen-btn--on-blue:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .zen-btn--ghost.zen-btn--on-light {
    background-color: transparent;
    color: var(--color-text-dark);
  }

  .zen-btn--ghost.zen-btn--on-light:hover {
    background-color: rgba(0, 0, 0, 0.05);
    color: var(--color-primary);
  }

  /* Icono estrictamente restringido */
  .zen-btn-icon {
    width: 18px !important;
    height: 18px !important;
    min-width: 18px !important;
    max-width: 18px !important;
    flex-shrink: 0;
  }

  .zen-btn--lg .zen-btn-icon {
    width: 18px !important;
    height: 18px !important;
    min-width: 18px !important;
    max-width: 18px !important;
  }

  @media (max-width: 640px) {
    .zen-btn {
      white-space: normal;
    }

    .zen-btn--lg {
      padding: 11px 18px;
      font-size: 14px;
    }

    .zen-btn--md {
      padding: 9px 16px;
      font-size: 13px;
    }
  }
</style>
